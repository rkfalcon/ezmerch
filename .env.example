# Use the EXISTING EZMerch Supabase project. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
# Enable the database-selected account after applying the account migration.
PRINTFUL_CONNECTION_SWITCH=false
PRINTFUL_NEXT_API_TOKEN=
PRINTFUL_NEXT_STORE_ID=
# Server-only URL token for order callbacks from both accounts.
PRINTFUL_ORDER_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Product availability, draft-product, and fulfillment notifications. Sender must be verified in Resend.
LINEUP_EMAIL_ENABLED=false
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
# Random server-only bearer secret used by the job scheduler.
CRON_SECRET=

# Hexadecimal signing secret returned by Printful v2 webhook registration.
PRINTFUL_STOCK_WEBHOOK_SECRET=

# Destination account stock webhook signing secret.
PRINTFUL_NEXT_STOCK_WEBHOOK_SECRET=
